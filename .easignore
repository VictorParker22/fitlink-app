supabase/

# Git
.git/
.github/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Build artifacts — and the native dirs THEMSELVES. android/ and ios/
# are gitignored prebuild artifacts, not source: git-based uploads never
# shipped them and EAS ran prebuild from app.json. The EAS_NO_VCS switch
# started uploading the stale local android/ (applicationId still
# 'fitlink.app', versionCode 1), which silently overrode app.json and
# broke processReleaseGoogleServices. Excluding them restores the
# managed-workflow behaviour every earlier build had.
android/
ios/

# Gemini/Antigravity
.gemini/

# Logs
*.log
npm-debug.log*

# Patches backup
*.orig

# ── Added for EAS_NO_VCS uploads ────────────────────────────────────
# git's file:// transport is broken on this machine (early EOF from
# upload-pack), so builds archive the working directory directly and THIS
# file is the only thing standing between local junk/secrets and the
# build servers. google-services.json is deliberately NOT listed: it is
# gitignored but the Android build genuinely needs it.
node_modules/
dist/
.expo/
.husky/
.claude/
.agents/
.env
.env.*
*.p12
*.keystore
*.jks
check_*.py
find_*.py
search*.py
*.py
