#!/usr/bin/env sh
# FitLink pre-commit. Ordered cheapest-and-most-irreversible first.
# Bypass with:  git commit --no-verify   (fine for WIP on a branch)

# 1. Secrets. The only genuinely unrecoverable mistake here.
node scripts/scan-secrets.js || exit 1

# 2. Invariants, against the staged content only. See .agents/INVARIANTS.md.
node scripts/verify.js --staged || exit 1

# 3. Typecheck — whole project, but only when TS actually changed (~11s).
#    A type error in an untouched file still blocks: tsc has no staged mode,
#    and a project that does not compile should not gain commits.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(ts|tsx)$'; then
  echo "typechecking…"
  npx tsc --noEmit || exit 1
fi
